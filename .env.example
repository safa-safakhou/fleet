# Private configuration. Copy to .env, chmod 600, generate independent secrets.
DATABASE_URL=postgres://fleet:CHANGE_ME@database:5432/fleet
FLEET_DB_PASSWORD=CHANGE_ME
FLEET_OPERATOR_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
FLEET_VAULT_KEY=GENERATE_32_RANDOM_BYTES_IN_BASE64
FLEET_ORIGIN=http://127.0.0.1:8820
# Optional HTTPS console: use its exact https origin and an existing proxy network.
# FLEET_ORIGIN=https://fleet.tinyagenttools.com
# FLEET_EDGE_NETWORK=pact-production_application
FLEET_LIVE_ENABLED=0
FLEET_CONCURRENCY=1
# Shared inference slots are separate from decision workers. Keep these matched
# to measured provider capacity; Ollama also needs OLLAMA_NUM_PARALLEL server-side.
FLEET_OLLAMA_CONCURRENCY=1
FLEET_COMPATIBLE_CONCURRENCY=1
# Historical defaults retained. Candidate pool: 16384 context, 300 seconds warm.
FLEET_OLLAMA_CONTEXT_LENGTH=32768
FLEET_OLLAMA_KEEP_ALIVE_SECONDS=0
FLEET_STATE_PATH=/app/.state
FLEET_MIN_FREE_BYTES=10737418240
FLEET_GAME=pact
FLEET_GAME_BASE_URL=https://pact.tinyagenttools.com
# Set endpoints and API credentials only after selecting a model/route and budget.
# MODEL_BASE_URL=https://approved-provider.example/v1
# MODEL_API_KEY=private
# Optional measured cache-token budget for vLLM, shared by legacy/native calls.
# FLEET_VLLM_TOKEN_CAPACITY=40000
# OLLAMA_BASE_URL=https://private-model-host.example
# Optional subscription-backed Codex route. Requires a native Linux CLI and dedicated private login directory.
# No login or inference happens at startup. See docs/codex-provider.md before setting these.
# FLEET_CODEX_EXECUTABLE=/opt/pact-codex/bin/codex
# FLEET_CODEX_HOME=/var/lib/pact-codex
FLEET_ALLOW_HTTP=0
# Optional CPU decision model; loopback only. See docs/decision-model.md.
# FLEET_DECISION_URL=http://127.0.0.1:8831
# Optional evaluated Laya recall service for LLM-centered cognition; loopback only.
# FLEET_LAYA_URL=http://127.0.0.1:8832

# Required for parallel explicit vLLM routes: authenticated, fresh provider cache metadata.
# FLEET_VLLM_CACHE_PROFILE=/private/owned-provider/cache-profile.json
# Rehearsals also require a fresh Windows-referenced clock-only control.
# FLEET_CLOCK_VALIDATION=/private/clock-validation.json
