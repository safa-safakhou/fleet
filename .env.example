# Private configuration. Copy to .env, chmod 600, generate independent secrets.
DATABASE_URL=postgres://fleet:CHANGE_ME@database:5432/fleet
FLEET_DB_PASSWORD=CHANGE_ME
FLEET_OPERATOR_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
FLEET_VAULT_KEY=GENERATE_32_RANDOM_BYTES_IN_BASE64
FLEET_ORIGIN=http://127.0.0.1:8820
FLEET_LIVE_ENABLED=0
FLEET_CONCURRENCY=1
FLEET_STATE_PATH=/app/.state
FLEET_MIN_FREE_BYTES=10737418240
FLEET_GAME=pact
FLEET_GAME_BASE_URL=https://pact.tinyagenttools.com
# Set endpoints and API credentials only after selecting a model/route and budget.
# MODEL_BASE_URL=https://approved-provider.example/v1
# MODEL_API_KEY=private
# OLLAMA_BASE_URL=https://private-model-host.example
# Optional subscription-backed Codex route. Requires a native Linux CLI and dedicated private login directory.
# No login or inference happens at startup. See docs/codex-provider.md before setting these.
# FLEET_CODEX_EXECUTABLE=/opt/pact-codex/bin/codex
# FLEET_CODEX_HOME=/var/lib/pact-codex
FLEET_ALLOW_HTTP=0
