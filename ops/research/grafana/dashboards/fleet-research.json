{
  "uid": "fleet-research-v1",
  "title": "Fleet Research v1",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": ["fleet", "research"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 100,
      "title": "Evidence authority and trace drilldown",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Operational projections are advisory. Inspect the authenticated run snapshot for native event and byte coverage. `no_capture_failure` is not a completeness/quality score. Trace IDs are available on the run event via the deterministic trace link; use Explore with Research Tempo. Missing backend timing remains unavailable."
      }
    },
    {
      "id": 1,
      "title": "Queue backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "research-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fleet_queue_pending)",
          "legendFormat": "{{component}}{{status}}{{state}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Queue delay p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "research-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fleet_queue_delay_milliseconds_bucket[5m])))",
          "legendFormat": "{{component}}{{status}}{{state}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
