{
  "name": "fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fleet": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit && biome check .",
    "test": "vitest run tests/unit",
    "test:architecture": "node --import tsx scripts/test-architecture-offline.ts",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "db:migrate": "tsx scripts/migrate.ts",
    "start": "node dist/server/main.js",
    "worker": "node dist/server/worker.js",
    "demo": "tsx scripts/demo.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "eval:offline": "vitest run tests/unit/evaluation.test.ts tests/unit/qualification.test.ts",
    "test:acceptance": "vitest run tests/acceptance --maxWorkers=1",
    "research:contracts:check": "tsx scripts/check-research-contracts.ts",
    "research:contracts:generate": "tsx scripts/check-research-contracts.ts --write",
    "test:properties": "tsx scripts/test-research-properties.ts",
    "test:observability": "node --import tsx scripts/test-research-observability.ts",
    "research:archive:verify": "node --import tsx scripts/verify-research-archive.ts",
    "eval:retrieval": "tsx scripts/evaluate-research-retrieval.ts",
    "eval:prompts": "tsx scripts/evaluate-research-prompts.ts",
    "optimize:offline": "tsx scripts/optimize-research.ts",
    "test:research-ui": "playwright test --config playwright.research.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@dagrejs/dagre": "3.1.3",
    "@grpc/grpc-js": "1.14.7",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "ajv": "8.20.0",
    "echarts": "6.1.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.1",
    "@temporalio/common": "1.25.0",
    "@temporalio/testing": "1.25.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "js-yaml": "5.4.3",
    "promptfoo": "0.125.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "basic-ftp": "6.2.4",
    "promptfoo": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
